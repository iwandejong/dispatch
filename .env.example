# Copy to .env (or run ./scripts/init-env.sh, which generates this for you). Never commit .env.

# Postgres password. The database is only reachable inside the compose network.
POSTGRES_PASSWORD=change-me

# Optional. The app has NO authentication, so it is published on 127.0.0.1 only by default.
# Set to 0.0.0.0 only behind something that authenticates (VPN, reverse proxy with auth, ...).
# BIND_ADDRESS=127.0.0.1
